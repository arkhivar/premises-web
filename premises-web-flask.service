[Unit]
Description=Premises Web App (Flask)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/premises-web
ExecStart=/srv/premises-web/.venv/bin/gunicorn --bind 0.0.0.0:3000 --workers 2 --timeout 120 "app:create_app()"
Environment=PATH=/srv/premises-web/.venv/bin:/usr/bin
Environment=DATABASE_URL=postgresql://premises:premises_dev_password@localhost:5432/premises_db?schema=public
Environment=NEXTAUTH_SECRET=0IZdNzY1dx5stJIssk+Vbqdol5TBZeWCX2kSfE92uOA=
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=premises-web

[Install]
WantedBy=multi-user.target
